# Server settings. Copy to .env in the repository root.
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081","http://localhost:8082","http://127.0.0.1:8082"]

# Server-only provider configuration. Never expose the partner token in the client.
ESIM_PROVIDER_BASE_URL=https://esim-api.terexov-tech.ru
ESIM_PARTNER_TOKEN=
ESIM_PUBLISHABLE_KEY=
# Separate server identity for catalog reads. Do not use it for user purchases.
ESIM_CATALOG_EXTERNAL_USER_ID=tursim-catalog
ESIM_REQUEST_TIMEOUT_SECONDS=15
# Optional HTTPS return URL, approved by the PSP operator. Omit for vendor pages.
# ESIM_PAYMENT_RETURN_URL=https://your-app.example/orders/{order_id}
ESIM_PAYMENT_ALLOWED_HOSTS=["payform.aurapay.tech"]
# Local durable quotes and idempotency keys; keep this file across API restarts.
# ORDERS_DATABASE_PATH=D:/esim/esim-platform/apps/api/var/orders.sqlite3

# Email-code login (server only). Gmail uses an app password and implicit TLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
# Generate at least 32 random characters; never use the example as a real secret.
AUTH_OTP_SECRET=
AUTH_OTP_TTL_SECONDS=300
# Local test database; set an absolute path to override.
# AUTH_DATABASE_PATH=D:/esim/esim-platform/apps/api/var/auth.sqlite3
# Set true when the API is served over HTTPS.
AUTH_COOKIE_SECURE=false

  "paths": {
    "/v1/partner/client-tokens": {
      "post": {
        "security": [
          {
            "PartnerToken": []
          }
        ],
        "description": "Issues a short-lived RS256 client_token bound to the partner's external_user_id. Idempotent via Idempotency-Key.",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "Partner"
        ],
        "summary": "Issue SDK client token",
        "parameters": [
          {
            "type": "string",
            "description": "Required idempotency token",
            "name": "Idempotency-Key",
            "in": "header",
            "required": true
          },
          {
            "description": "External user id and optional TTL override",
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/partner.issueClientTokenRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/partner.issueClientTokenEnvelope"
            }
          },
          "400": {
            "description": "validation_error (external_user_id пустой/слишком длинный, ttl_seconds вне [300, 604800]) | missing_idempotency_key | invalid_idempotency_key",
            "schema": {
              "$ref": "#/definitions/handlers.ErrorEnvelope"
            }
          },
          "401": {
            "description": "missing_bearer_token | invalid_token",
            "schema": {
              "$ref": "#/definitions/handlers.ErrorEnvelope"
            }
          },
          "409": {
            "description": "request_in_progress",
            "schema": {
              "$ref": "#/definitions/handlers.ErrorEnvelope"
            }
          },
          "422": {
            "description": "idempotency_key_reused",
            "schema": {
              "$ref": "#/definitions/handlers.ErrorEnvelope"
            }
          },
          "500": {
            "description": "internal_error",
            "schema": {
              "$ref": "#/definitions/handlers.ErrorEnvelope"
            }
          }
        }
      }
    },
    "/v1/sdk/orders": {
      "get": {
        "security": [
          {
            "ClientToken": [],
            "PublishableKey": []
          }
        ],
        "description": "Returns the authenticated user's orders newest-first with cursor pagination.\n\nКаждая запись — это сокращённая проекция заказа без `payment` и `provision`. Значения `state` те же, что у `GET /v1/sdk/orders/{id}`: `pending_payment`, `paid`, `provisioning`, `delivered`, `failed`, `cancelled`. Поле `remaining` равно `null`, пока eSIM не выдан или usage-sync ещё не наблюдал трафик. `esim_status` — статус самой eSIM у провайдера (`issued` → `installed` → `activated` → `active` → `depleted` / `expired`), `null` до выдачи и до первого наблюдения; клиент должен терпеть неизвестные значения. Описание полной матрицы \"какие поля null при каком статусе\" см. в `GET /v1/sdk/orders/{id}`.",
        "produces": [
          "application/json"
        ],
        "tags": [
          "SDK Orders"
        ],
        "summary": "List orders",
        "parameters": [
          {
            "type": "string",
            "description": "Opaque pagination cursor",
            "name": "cursor",
            "in": "query"
          },
          {
            "type": "integer",
            "description": "Page size (default 50, max 100)",
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/sdk.listOrdersEnvelope"
            }
          },
          "400": {
            "description": "invalid_limit | invalid_cursor",
            "schema": {
              "$ref": "#/definitions/handlers.ErrorEnvelope"
            }
          },
          "401": {
            "description": "SDK auth failure",
            "schema": {
              "$ref": "#/definitions/handlers.ErrorEnvelope"
            }
          },
          "500": {
            "description": "internal_error",
            "schema": {
              "$ref": "#/definitions/handlers.ErrorEnvelope"
            }
          }
        }
      },
      "post": {
        "security": [
          {
            "ClientToken": [],
            "PublishableKey": []
          }
        ],
        "description": "Creates a single-item order for the given storefront plan and authorizes payment with the configured PSP.\n\nНа успехе возвращает заказ в стартовом `state == \"pending_payment\"` с `payment.state == \"pending\"`, заполненными `payment.url` и `payment.expires_at` — клиент SDK открывает `payment.url` для оплаты. Описание всех значений `state` и матрицу \"какие поля null при каком статусе\" см. в `GET /v1/sdk/orders/{id}`.\n\n`return_url` (необязательно) — куда касса вернёт покупателя и после оплаты, и после отказа: абсолютный https-адрес до 512 символов с разрешённым оператором префиксом; `{order_id}` (не больше одного) заменяется на id заказа. Без него — страницы витрины.",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "SDK Orders"
        ],
        "summary": "Create order",
        "parameters": [
          {
            "type": "string",
            "description": "Required idempotency token; replay returns the cached response",
            "name": "Idempotency-Key",
            "in": "header",
            "required": true
          },
          {
            "description": "Storefront plan ids (exactly one)",
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/sdk.createOrderRequest"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "schema": {
              "$ref": "#/definitions/sdk.orderEnvelope"
            }
          },
          "400": {
            "description": "invalid_body | validation_error | too_many_ids | invalid_id | invalid_return_url | missing_idempotency_key | invalid_idempotency_key",
            "schema": {
              "$ref": "#/definitions/handlers.ErrorEnvelope"
            }
          },
          "401": {
            "description": "SDK auth failure",
            "schema": {
              "$ref": "#/definitions/handlers.ErrorEnvelope"
            }
          },
          "402": {
            "description": "payment_declined — заказ сохранён, id в error.detail (order_id=<uuid>)",
            "schema": {
              "$ref": "#/definitions/handlers.ErrorEnvelope"
            }
          },
          "404": {
            "description": "plan_not_found",
            "schema": {
              "$ref": "#/definitions/handlers.ErrorEnvelope"
            }
          },
          "409": {
            "description": "request_in_progress — параллельный запрос с тем же Idempotency-Key",
            "schema": {
              "$ref": "#/definitions/handlers.ErrorEnvelope"
            }
          },
          "422": {
            "description": "idempotency_conflict | idempotency_key_reused",
            "schema": {
              "$ref": "#/definitions/handlers.ErrorEnvelope"
            }
          },
          "500": {
            "description": "internal_error",
            "schema": {
              "$ref": "#/definitions/handlers.ErrorEnvelope"
            }
          }
        }
      }
    },
    "/v1/sdk/orders/summary": {
      "post": {
        "security": [
          {
            "ClientToken": [],
            "PublishableKey": []
          }
        ],
        "description": "Computes price totals for a cart of storefront plan ids. v1 expects exactly one id.",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "SDK Orders"
        ],
        "summary": "Cart summary",
        "parameters": [
          {
            "description": "Cart ids",
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/sdk.summaryRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/sdk.summaryEnvelope"
            }
          },
          "400": {
            "description": "invalid_body | invalid_id | invalid_ids_length",
            "schema": {
              "$ref": "#/definitions/handlers.ErrorEnvelope"
            }
          },
          "401": {
            "description": "SDK auth failure",
            "schema": {
              "$ref": "#/definitions/handlers.ErrorEnvelope"
            }
          },
          "404": {
            "description": "tariff_not_found",
            "schema": {
              "$ref": "#/definitions/handlers.ErrorEnvelope"
            }
          },
          "422": {
            "description": "currency_mismatch",
            "schema": {
              "$ref": "#/definitions/handlers.ErrorEnvelope"
            }
          },
          "500": {
            "description": "internal_error",
            "schema": {
              "$ref": "#/definitions/handlers.ErrorEnvelope"
            }
          }
        }
      }
    },
    "/v1/sdk/orders/{id}": {
      "get": {
        "security": [
          {
            "ClientToken": [],
            "PublishableKey": []
          }
        ],
        "description": "Returns the full order envelope including delivery state. Cross-user access returns 404 (not 403) to disguise existence.\n\n### Жизненный цикл `state` (поле `data.state`)\n\nСоответствует CHECK-инварианту таблицы `orders` (migrations/00007):\n* `pending_payment` — стартовое; ждём оплату от пользователя.\n* `paid` — PSP подтвердил оплату webhook'ом `payments.captured`.\n* `provisioning` — outbox-воркер пытается зарезервировать eSIM у провайдера (smcard).\n* `delivered` — eSIM выдан; в `provision` лежат `iccid`, `activation_code`, `smdp_address`, `matching_id`, `qr_code_url`.\n* `failed` — оплата отклонена/истекла, либо провижининг провалился окончательно (см. `payment.failure_code` / `provision.state`).\n* `cancelled` — заказ отменён админом или прошёл возврат (`payment.state == \"refunded\"`).\n\n### Какие поля заполнены / `null` на каком статусе\n\nОбозначения: `+` — поле всегда присутствует и не `null`; `-` — поле равно `null` либо отсутствует в JSON; `?` — может присутствовать, см. примечания ниже.\n\n| Поле                              | pending_payment | paid | provisioning | delivered | failed | cancelled |\n|-----------------------------------|:---------------:|:----:|:------------:|:---------:|:------:|:---------:|\n| `payment.state`                   | `pending` / `authorizing` | `captured` | `captured` | `captured` | `failed` | `captured` или `refunded` |\n| `payment.url`                     | + (при `payment.state == \"pending\"`) | - | - | - | - | - |\n| `payment.expires_at`              | + (вместе с `payment.url`) | - | - | - | - | - |\n| `payment.failure_code`            | - | - | - | - | + | - |\n| `provision`                       | `null` | `null` | ? (объект, `state` = `pending` / `requested`) | + (объект, `state == \"delivered\"`) | ? (если упало в провижининге — `state == \"failed\"`) | ? (если успели создать) |\n| `provision.iccid`                 | - | - | - | + | - | - |\n| `provision.activation_code`       | - | - | - | + | - | - |\n| `provision.smdp_address`          | - | - | - | ? (когда LPA-строка well-formed) | - | - |\n| `provision.matching_id`           | - | - | - | ? (когда LPA-строка well-formed) | - | - |\n| `provision.qr_code_url`           | - | - | - | ? (при сбое presign S3 — пусто, ответ всё равно 200) | - | - |\n| `provision.qr_code_url_expires`   | - | - | - | ? (вместе с `qr_code_url`) | - | - |\n| `remaining`                       | `null` | `null` | `null` | ? (`null` до первого usage-sync, далее объект) | `null` | `null` |\n| `esim_status`                     | `null` | `null` | `null` | ? (`issued` → `installed` → `activated` → `active` → `depleted` / `expired`; `null` до первого наблюдения) | `null` | ? |\n| `activated_at`, `expires_at`      | `null` | `null` | `null` | ? (после первой регистрации eSIM в сети) | `null` | ? |\n| `esim`, `tariff`, `items`         | + | + | + | + | + | + |\n| `id`, `order_number`, `total_*`, `created_at` | + | + | + | + | + | + |\n\nПримечания:\n* `failed` достижим двумя путями. (1) Из `pending_payment` после `payments.failed` / `payments.expired` — `payment.failure_code` заполнен (`card_declined`, `provider_error`, `provider_failed`, `expired`), `provision` равен `null`. (2) Из `provisioning` после окончательного отказа провайдера — `payment.state == \"captured\"` без `failure_code`, `provision.state == \"failed\"`.\n* `cancelled` достигается через админ-flow (`POST /v1/admin/orders/{id}/cancel`) или по webhook'у `payments.refunded`. Если переход случился после доставки eSIM, `provision` остаётся в JSON с прежним содержимым; `qr_code_url` всё равно пересоздаётся как 5-минутный presign на каждом запросе.\n* На `delivered` `qr_code_url` и/или `activation_code` могут оказаться пустыми, если расшифровка LPA или presign S3 транзитно упали — handler намеренно отвечает 200 с частичным телом, SDK должен опросить заказ ещё раз.",
        "produces": [
          "application/json"
        ],
        "tags": [
          "SDK Orders"
        ],
        "summary": "Get order",
        "parameters": [
          {
            "type": "string",
            "format": "uuid",
            "description": "Order UUID",
            "name": "id",
            "in": "path",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/sdk.orderEnvelope"
            }
          },
          "400": {
            "description": "invalid_order_id",
            "schema": {
              "$ref": "#/definitions/handlers.ErrorEnvelope"
            }
          },
          "401": {
            "description": "SDK auth failure",
            "schema": {
              "$ref": "#/definitions/handlers.ErrorEnvelope"
            }
          },
          "404": {
            "description": "order_not_found (включая случай, когда заказ принадлежит другому пользователю — намеренно отдаём 404, а не 403)",
            "schema": {
              "$ref": "#/definitions/handlers.ErrorEnvelope"
            }
          },
          "500": {
            "description": "internal_error",
            "schema": {
              "$ref": "#/definitions/handlers.ErrorEnvelope"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "partner.issueClientTokenRequest": {
      "type": "object",
      "required": [
        "external_user_id"
      ],
      "properties": {
        "external_user_id": {
          "type": "string",
          "example": "u_42"
        },
        "ttl_seconds": {
          "description": "Pointer so we can distinguish \"absent\" from an explicit zero. Absent\n→ use service default; zero → service rejects with ErrTTLOutOfRange.",
          "type": "integer",
          "maximum": 604800,
          "minimum": 300,
          "example": 86400
        }
      }
    },
    "partner.issueClientTokenEnvelope": {
      "type": "object",
      "required": [
        "data",
        "request_id"
      ],
      "properties": {
        "data": {
          "$ref": "#/definitions/partner.issueClientTokenResponse"
        },
        "request_id": {
          "type": "string",
          "example": "req_2f4c1a90"
        }
      }
    },
    "handlers.ErrorEnvelope": {
      "type": "object",
      "required": [
        "error",
        "request_id"
      ],
      "properties": {
        "error": {
          "$ref": "#/definitions/handlers.ErrorBody"
        },
        "request_id": {
          "type": "string",
          "example": "req_2f4c1a90"
        }
      }
    },
    "sdk.listOrdersEnvelope": {
      "type": "object",
      "required": [
        "data",
        "meta",
        "request_id"
      ],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/sdk.listOrderItemDTO"
          }
        },
        "meta": {
          "$ref": "#/definitions/handlers.ListMeta"
        },
        "request_id": {
          "type": "string",
          "example": "req_2f4c1a90"
        }
      }
    },
    "sdk.createOrderRequest": {
      "type": "object",
      "required": [
        "ids"
      ],
      "properties": {
        "ids": {
          "description": "storefront_plan_id values, UUID strings",
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": [
            "0e2a8c1d-3b4f-5a6e-7c8d-9f0a1b2c3d4e"
          ]
        },
        "return_url": {
          "description": "ReturnURL (optional): where the PSP sends the payer after paying or\nfailing — an absolute https URL of at most 512 characters under one of\nthe operator's allowed prefixes, with at most one {order_id} (replaced\nby the new order's id). Absent: the storefront's own result pages.",
          "type": "string",
          "example": "https://zloy-card.ru/services/orders/{order_id}"
        }
      }
    },
    "sdk.orderEnvelope": {
      "type": "object",
      "required": [
        "data",
        "request_id"
      ],
      "properties": {
        "data": {
          "$ref": "#/definitions/sdk.orderResponse"
        },
        "request_id": {
          "type": "string",
          "example": "req_2f4c1a90"
        }
      }
    },
    "sdk.summaryRequest": {
      "type": "object",
      "required": [
        "ids"
      ],
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": [
            "0e2a8c1d-3b4f-5a6e-7c8d-9f0a1b2c3d4e"
          ]
        }
      }
    },
    "sdk.summaryEnvelope": {
      "type": "object",
      "required": [
        "data",
        "request_id"
      ],
      "properties": {
        "data": {
          "$ref": "#/definitions/sdk.summaryResponse"
        },
        "request_id": {
          "type": "string",
          "example": "req_2f4c1a90"
        }
      }
    },
    "partner.issueClientTokenResponse": {
      "type": "object",
      "required": [
        "expires_at",
        "jti",
        "token"
      ],
      "properties": {
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "example": "2026-05-03T15:00:00Z"
        },
        "jti": {
          "type": "string",
          "example": "9b3e1f0c4ad57e2f8aab12cd34ef5670"
        },
        "token": {
          "type": "string",
          "example": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..."
        }
      }
    },
    "handlers.ErrorBody": {
      "type": "object",
      "required": [
        "code",
        "status",
        "title"
      ],
      "properties": {
        "code": {
          "type": "string",
          "example": "plan_not_found"
        },
        "detail": {
          "type": "string",
          "example": "order_id=7c1f2a3b-4d5e-6f7a-8b9c-0d1e2f3a4b5c"
        },
        "instance": {
          "type": "string",
          "example": "/v1/sdk/orders"
        },
        "meta": {
          "description": "Meta carries machine-readable details for errors the client acts on\n(e.g. amount_out_of_range → {min, max}). Omitted for every other error.",
          "type": "object",
          "additionalProperties": {}
        },
        "status": {
          "type": "integer",
          "example": 404
        },
        "title": {
          "type": "string",
          "example": "plan not found"
        },
        "type": {
          "type": "string",
          "example": "about:blank"
        }
      }
    },
    "sdk.listOrderItemDTO": {
      "type": "object",
      "required": [
        "created_at",
        "esim",
        "id",
        "order_number",
        "remaining",
        "state",
        "tariff",
        "total_amount_minor",
        "total_currency"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time",
          "example": "2026-05-01T10:15:30Z"
        },
        "esim": {
          "$ref": "#/definitions/sdk.esimSummaryDTO"
        },
        "esim_status": {
          "description": "null until observed",
          "type": "string",
          "enum": [
            "issued",
            "installed",
            "activated",
            "active",
            "depleted",
            "expired"
          ],
          "x-nullable": "true",
          "example": "installed"
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "example": "7c1f2a3b-4d5e-6f7a-8b9c-0d1e2f3a4b5c"
        },
        "order_number": {
          "type": "integer",
          "example": 10000000000042
        },
        "remaining": {
          "$ref": "#/definitions/sdk.trafficAmountDTO"
        },
        "state": {
          "$ref": "#/definitions/sdk.OrderState"
        },
        "tariff": {
          "$ref": "#/definitions/sdk.tariffSummaryDTO"
        },
        "total_amount_minor": {
          "type": "number",
          "format": "float",
          "example": 990
        },
        "total_currency": {
          "type": "string",
          "example": "RUB"
        }
      }
    },
    "handlers.ListMeta": {
      "type": "object",
      "required": [
        "has_more"
      ],
      "properties": {
        "has_more": {
          "type": "boolean",
          "example": false
        },
        "next_cursor": {
          "type": "string",
          "example": "eyJpZCI6Ijdj..."
        },
        "total": {
          "type": "integer",
          "example": 68
        }
      }
    },
    "sdk.orderResponse": {
      "type": "object",
      "required": [
        "created_at",
        "esim",
        "id",
        "items",
        "order_number",
        "payment",
        "remaining",
        "state",
        "tariff",
        "total_amount_minor",
        "total_currency"
      ],
      "properties": {
        "activated_at": {
          "type": "string",
          "format": "date-time",
          "x-nullable": "true"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "example": "2026-05-01T10:15:30Z"
        },
        "esim": {
          "$ref": "#/definitions/sdk.esimSummaryDTO"
        },
        "esim_status": {
          "description": "EsimStatus is the provider-side eSIM lifecycle — what happened to the\neSIM after delivery (installed on the device? attached to the network?),\nunlike State, which is our order pipeline. Passed through verbatim, so\nSDK clients must tolerate values outside the enum. ActivatedAt /\nExpiresAt fill in once the eSIM first attaches to the destination\nnetwork (duration_days counts from ActivatedAt).",
          "type": "string",
          "enum": [
            "issued",
            "installed",
            "activated",
            "active",
            "depleted",
            "expired"
          ],
          "x-nullable": "true",
          "example": "installed"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "x-nullable": "true"
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "example": "7c1f2a3b-4d5e-6f7a-8b9c-0d1e2f3a4b5c"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/sdk.orderItemDTO"
          }
        },
        "order_number": {
          "type": "integer",
          "example": 10000000000042
        },
        "payment": {
          "$ref": "#/definitions/sdk.paymentDTO"
        },
        "provision": {
          "description": "null until worker has run",
          "allOf": [
            {
              "$ref": "#/definitions/sdk.orderProvisionDTO"
            }
          ],
          "x-nullable": "true"
        },
        "remaining": {
          "$ref": "#/definitions/sdk.trafficAmountDTO"
        },
        "state": {
          "$ref": "#/definitions/sdk.OrderState"
        },
        "tariff": {
          "$ref": "#/definitions/sdk.tariffSummaryDTO"
        },
        "total_amount_minor": {
          "type": "number",
          "format": "float",
          "example": 990
        },
        "total_currency": {
          "type": "string",
          "example": "RUB"
        }
      }
    },

    "sdk.esimRefDTO": {
      "type": "object",
      "required": [
        "country",
        "id",
        "image_url",
        "name",
        "phone_code",
        "slug",
        "updated_at"
      ],
      "properties": {
        "country": {
          "type": "string",
          "example": "UZ"
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "example": "8a17d9b6-1c2e-4f3a-9d6e-3a4b5c6d7e8f"
        },
        "image_url": {
          "type": "string",
          "example": "https://cdn.example.com/uz.jpg"
        },
        "min_price_amount": {
          "description": "MinPriceAmount / MinPriceCurrency render the \"from N\" label on a\ncountry row: the cheapest tariff that is purchasable right now. Both\nare null together when the eSIM has none — clients treat that as \"no\nprice to show\", not as a free plan, so the fields are pointers and\ncarry no binding:\"required\".\n\nMinPriceAmount is in MAJOR units (4550 minor → 45.5), matching\ntariffDTO.PriceAmountMinor's existing — and misleadingly named —\nconvention. Keeping the two consistent matters more than fixing the\nname, which is already load-bearing for shipped clients.",
          "type": "number",
          "x-nullable": true,
          "example": 45.5
        },
        "min_price_currency": {
          "type": "string",
          "x-nullable": true,
          "example": "RUB"
        },
        "name": {
          "type": "string",
          "example": "Узбекистан"
        },
        "network": {
          "description": "Network is the operator and network line of the country (spec web\n§7.5); null when the admin has not set one. Old apps ignore it.",
          "type": "string",
          "x-nullable": true,
          "example": "Turkcell · 4G/5G"
        },
        "phone_code": {
          "type": "string",
          "example": "+998"
        },
        "photo_url": {
          "description": "PhotoURL is the scenic country photo (the catalogue card background and\nthe tariffs-screen header), as opposed to ImageURL's flag icon. It is a\npointer so an unset photo serializes as JSON null rather than \"\": the\nclient contract treats null/empty/absent alike, and null states \"no\nphoto\" without shipping a meaningless empty string to every client.",
          "type": "string",
          "x-nullable": true,
          "example": "https://cdn.example.com/tr-istanbul.jpg"
        },
        "seo_description": {
          "type": "string",
          "x-nullable": true
        },
        "seo_title": {
          "description": "SEO overrides for the country page; null = not set (the web derives them).",
          "type": "string",
          "x-nullable": true
        },
        "slug": {
          "description": "Slug is the readable page address of the country (\"turtsiya\"); it is\naccepted wherever {id} is, and is what the web builds /services/esim/<slug> from.",
          "type": "string",
          "example": "turtsiya"
        },
        "updated_at": {
          "description": "UpdatedAt (RFC 3339, UTC) feeds sitemap lastmod.",
          "type": "string",
          "format": "date-time",
          "example": "2026-10-16T09:30:00Z"
        }
      }
    }
  },

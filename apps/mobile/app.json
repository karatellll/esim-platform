      }
    },
    "android": {
      "predictiveBackGestureEnabled": true,
      "package": "com.karatel.tursim"
    },
    "plugins": [
      "expo-image"
    ],
    "extra": {
      "eas": {
        "projectId": "07e2ce4d-f2d2-49e5-9fd7-8265b10ca27e"
      }
    }
  }
}
